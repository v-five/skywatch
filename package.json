    "test": "claude plugin test claude-code",
    "validate": "sh scripts/validate-snapshot.sh | diff scripts/validate-baseline.txt -"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "typescript": "7.0.2"
  }
}
